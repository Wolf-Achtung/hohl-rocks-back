# -*- coding: utf-8 -*-
# Environment variables for hohl.rocks backend (FastAPI on Railway)
# Rename to `.env` and fill in the keys before deploying.

# --- API Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# --- Security / CORS ---
# Comma-separated allowlist; leave empty to allow all origins.
ALLOWED_ORIGINS=https://hohl.rocks,https://*.netlify.app

# --- Feature flags ---
EU_ONLY=0
SPARK_ENABLE=true
SPARK_ROTATION=prompt,insight,tool,funding
SPARK_CACHE_TTL_SEC=86400
NEWS_TTL_HOURS=24
TIPS_TTL_HOURS=24

# --- Server ---
PORT=8000
LOG_LEVEL=info
