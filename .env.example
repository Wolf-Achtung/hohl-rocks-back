# --- CORS ---
CORS_ALLOWLIST=https://hohl.rocks,https://www.hohl.rocks,https://*.netlify.app,http://localhost:8080

# --- LLM Providers ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-small

# --- Tavily News ---
TAVILY_API_KEY=
# Strenge Whitelist, damit Sport & US-Entertainment nicht reinkommen:
NEWS_DOMAINS=heise.de,golem.de,t3n.de,the-decoder.de,tagesschau.de,zdf.de,br.de,netzpolitik.org,handelsblatt.com,wiwo.de,spiegel.de,faz.net,zeit.de,nzz.ch,srf.ch,20min.ch,computerbase.de,chip.de,sueddeutsche.de

# --- Compliance & Metrics ---
EU_ONLY=0
METRICS=console

# --- Server ---
PORT=8080
NODE_ENV=production
