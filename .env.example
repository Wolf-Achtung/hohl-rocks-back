# --- CORS ---
CORS_ALLOWLIST=https://hohl.rocks,https://www.hohl.rocks,https://*.netlify.app,http://localhost:8080

# --- LLM Providers ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-small

# --- KI-Tipps & News (Tavily) ---
TAVILY_API_KEY=
# Kuratierte DACH-Tech-Quellen (Tipps/How-To bevorzugt)
NEWS_DOMAINS=the-decoder.de,heise.de,golem.de,t3n.de,computerbase.de,chip.de,netzpolitik.org,handelsblatt.com,wiwo.de,spiegel.de,faz.net,zeit.de,nzz.ch,computerwoche.de,datenschutz-notizen.de
# Cache-Lebensdauer in Stunden (SWR): nach Ablauf werden alte Ergebnisse sofort zurückgegeben und im Hintergrund aktualisiert
NEWS_TTL_HOURS=24

# --- Compliance & Metrics ---
EU_ONLY=0
METRICS=console

# --- Server ---
PORT=8080
NODE_ENV=production
