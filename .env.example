# ---- CORS ----
CORS_ALLOWLIST=https://hohl.rocks,https://www.hohl.rocks,https://*.netlify.app,http://localhost:8080

# ---- LLM Providers ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-small

# ---- KI-Quellen (Tavily) ----
TAVILY_API_KEY=

# News (regulatorisch, Releases, Sicherheit), streng DACH
NEWS_DOMAINS=heise.de,golem.de,t3n.de,netzpolitik.org,tagesschau.de,zdf.de,spiegel.de,faz.net,zeit.de,nzz.ch,srf.ch,handelsblatt.com,wiwo.de
NEWS_TTL_HOURS=24

# Tipps (How-To, Praxis, Prompting), stärker Tech/How-To orientiert
TIPS_TTL_HOURS=24

# ---- Replicate (optional) ----
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=black-forest-labs/flux-1.1-pro
REPLICATE_LLAVA_VERSION=liuhaotian/llava-13b
REPLICATE_MUSICGEN_VERSION=facebook/musicgen

# ---- Compliance & Metrics ----
EU_ONLY=0
METRICS=console

# ---- Server ----
PORT=8080
NODE_ENV=production
