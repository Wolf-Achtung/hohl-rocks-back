# ===================================================================
# HOHL.ROCKS BACKEND - Environment Variables
# ===================================================================

# ===================================================================
# API KEYS (REQUIRED)
# ===================================================================

# Anthropic Claude API Key
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API Key  
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Perplexity API Key
# Get it from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# Google Gemini API Key
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ===================================================================
# SERVER CONFIGURATION (OPTIONAL)
# ===================================================================

# Server Port (Railway sets this automatically)
PORT=8080

# Node Environment (development | production)
NODE_ENV=development

# AI Models to use (override when a provider deprecates/renames a model,
# without needing a code change + redeploy)
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5-mini
PERPLEXITY_MODEL=sonar-pro
GEMINI_MODEL=gemini-3.5-flash

# Der Name ueber der Antwort im Modellvergleich. Beim Wechsel der Modell-ID
# oben mitaendern - sonst steht der alte Name ueber der neuen Antwort.
CLAUDE_MODEL_NAME=Claude Sonnet 5
OPENAI_MODEL_NAME=GPT-5 Mini
PERPLEXITY_MODEL_NAME=Perplexity Sonar Pro
GEMINI_MODEL_NAME=Gemini 3.5 Flash

# ===================================================================
# KI-NEWS (OPTIONAL)
# ===================================================================

# Kommagetrennte Domain-Liste fuer die taegliche KI-News-Suche
# (Perplexity search_domain_filter, max. 10 Eintraege).
# Leer = ohne Einschraenkung suchen.
NEWS_DOMAINS=heise.de,the-decoder.de,t3n.de

# ===================================================================
# CORS CONFIGURATION (OPTIONAL)
# ===================================================================

# Allowed Origins (comma-separated)
# Example: https://hohl.rocks,https://www.hohl.rocks
# Default: http://localhost:3000,http://localhost:5173,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===================================================================
# ADMIN (OPTIONAL)
# ===================================================================

# Hinweis: Es gibt keine Datenbank mehr. Gespraeche liegen nur im Prozess
# (src/config/chatLog.js), DATABASE_URL und DB_SSL_REJECT_UNAUTHORIZED
# werden nirgends gelesen und sind hier deshalb entfernt. Falls sie in der
# Deploy-Umgebung noch gesetzt sind: dort ebenfalls loeschen - eine gesetzte
# DATABASE_URL ist ein Zugangsdatum ohne Verbraucher.

# Admin API Key for accessing /api/admin/* endpoints
# Generate a secure random string, e.g.: openssl rand -hex 32
ADMIN_API_KEY=your-secure-admin-key-here

# ===================================================================
# NOTES
# ===================================================================

# Development:
#   - Copy this file to .env
#   - Fill in your API keys
#   - Run: npm run dev

# Production (Railway):
#   - Set these variables in Railway Dashboard
#   - Don't commit .env file!
#   - Railway sets PORT automatically

# Security:
#   - Never commit API keys to Git
#   - Add .env to .gitignore
#   - Use Railway environment variables for production
