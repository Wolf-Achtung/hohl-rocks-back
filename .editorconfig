# -*- coding: utf-8 -*-
# EditorConfig helps maintain consistent coding styles for multiple developers working on the same project.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.{js,jsx,ts,tsx,json}]
indent_size = 2
