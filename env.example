# ===== hohl.rocks — .env.example (Public Template) =====
# Diese Datei darf ins Repository committed werden. KEINE echten Keys!
# Kopiere sie für Produktion/Preview nach `.env` und trage Secrets ein.

# --- Runtime ---
NODE_ENV=production
PORT=8080

# --- URLs / CORS ---
SITE_URL=https://hohl.rocks
ALLOWED_ORIGINS="https://hohl.rocks,https://www.hohl.rocks"
CORS_ALLOWLIST="https://hohl.rocks,https://www.hohl.rocks"

# --- APIs (Platzhalter – KEINE echten Keys hier eintragen) ---
OPENAI_API_KEY=__SET_ME__
ANTHROPIC_API_KEY=__SET_ME__
PERPLEXITY_API_KEY=__SET_ME__
OPENROUTER_API_KEY=__SET_ME__

# Modelle (sichere Default-Bezeichnungen; gern anpassen)
OPENAI_MODEL="gpt-4o-mini"
CLAUDE_MODEL="claude-sonnet-4"
OPENROUTER_MODEL="mistralai/mistral-small"
PERPLEXITY_MODEL="sonar-pro"

# --- News (fokussiert auf KI/Tech/Praxis/Prompting) ---
NEWS_TTL_HOURS=24
NEWS_DOMAINS="heise.de,the-decoder.de,golem.de,t3n.de,therundown.ai,towardsdatascience.com,promptengineeringdaily.com,gptforwork.com"

# FEEDS: Override AKTIV – ersetzt interne Defaults vollständig
# Wichtig: Einzeilige, valide JSON-Map!
NEWS_FEEDS_JSON='{"the-decoder.de":["https://the-decoder.de/feed/"],"heise.de":["https://www.heise.de/rss/heise-atom.xml"],"golem.de":["https://rss.golem.de/rss.php?feed=RSS2.0"],"t3n.de":["https://t3n.de/rss.xml"],"therundown.ai":["https://rss.beehiiv.com/feeds/2R3C6Bt5wj.xml"],"towardsdatascience.com":["https://towardsdatascience.com/feed"],"promptengineeringdaily.com":["https://promptengineeringdaily.substack.com/feed"],"gptforwork.com":["https://gptforwork.com/blog/rss.xml"]}'

# --- UI Flags ---
UI_MODAL_SHADE=0.15
UI_REMOVE_NAV_SOUND=true

# --- Research (breit erlauben, problematische Quellen blocken) ---
RESEARCH_ALLOW=
RESEARCH_BLOCK="reddit.com,medium.com"

# Hinweise:
# - Trage echte Secrets NUR in der privaten .env oder im Railway/Netlify-Dashboard ein.
# - NEWS_FEEDS_JSON ist hier absichtlich aktiv, damit Entwickler lokal sofort
#   die gleichen Feeds erhalten. In Produktion kann alternativ nur NEWS_DOMAINS genutzt werden.
